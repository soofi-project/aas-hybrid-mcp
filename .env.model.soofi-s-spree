# soofi-s-spree -- Soofi-S-Spree-Preview, direkt auf eigener vLLM-Instanz (VPN/mrk40-LAN noetig).
# Endpoint: http://10.2.10.44:8000/v1 -- Key wird nicht geprueft ("dummy" genuegt).
# Wird vom Overlay docker-compose.eval-model-litellm.yml geladen (Slug soofi-*), das
# OPENAI_API_KEY aus SOOFI_LLM_API_KEY setzt; fuer diese Instanz ist der Wert egal.
LLM_BASE_URL=http://10.2.10.44:8000/v1
LLM_MODEL=soofi-s
# Query-Rewrite (nur search_aas_documents) bleibt auf dem Default aus .env.vllm (qwen36-27b, H200),
# damit das zu testende Modell nicht ueber Rewrite/Embeddings in die Retrieval-Kette geraet.

# Thinking: Standard aus; der Thinking-Lauf wird ueber --reasoning-effort pro Lauf
# gesetzt (run_all.sh <slug> <temp> <effort>), siehe model-eval Skill.
AGENT_DEFAULT_THINKING=false

# Schwache Selbstkorrektur -> viele Tool-Calls; wie beim rlvr-spree-Checkpoint angehoben.
AGENT_RECURSION_LIMIT=200

# Nur Lesepfad getestet: Template-Klassen-Generierung ueberspringen (Sync-Service liest .env.model).
GENERATE_TEMPLATE_CLASSES=false

# Nur Lesepfad getestet: Template-Klassen-Generierung ueberspringen (Sync-Service liest .env.model).
GENERATE_TEMPLATE_CLASSES=false
